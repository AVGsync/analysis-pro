{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "REST API для Analysis Pro: авторизация, профиль пользователя, детализация продаж, прогнозы по товарам, рекомендации по закупкам и экспорт CSV/XML.\n\nСхема авторизации: вызовите `POST /auth/login`; API установит HttpOnly cookie `token`. Защищённые маршруты читают JWT только из cookie.\nSwagger UI доступен только при `DEBUG=true`: `/swagger`, JSON спецификация — `/swagger/doc.json`.",
        "title": "API Analysis Pro",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Проверяет email и пароль пользователя.\nПри успехе устанавливает JWT в HttpOnly cookie с именем `token`.\nЗащищённые маршруты используют только cookie `token`.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "Авторизация"
                ],
                "summary": "Войти в аккаунт",
                "parameters": [
                    {
                        "description": "Данные входа: email и пароль. Примеры значений указаны в схеме.",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model_request.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        },
                        "headers": {
                            "Set-Cookie": {
                                "type": "string",
                                "description": "token=\u003cjwt\u003e; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=86400"
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректное тело запроса",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Неверный email или пароль",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "description": "Создаёт аккаунт по полному имени, email и паролю.\nEmail должен быть уникальным. Пароль хранится в виде хеша и никогда не возвращается в ответе.\nПри успехе возвращает профиль созданного пользователя без токена; после регистрации вызовите /auth/login.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Авторизация"
                ],
                "summary": "Зарегистрировать нового пользователя",
                "parameters": [
                    {
                        "description": "Данные регистрации: полное имя, email и пароль. Примеры значений указаны в схеме.",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model_request.NewUserRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Профиль созданного пользователя",
                        "schema": {
                            "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model_response.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректное тело запроса",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Не удалось зарегистрировать пользователя",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/me": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Возвращает профиль пользователя, определённого по JWT claims.\nТребует валидную cookie `token`, полученную через /auth/login.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Получить профиль текущего пользователя",
                "responses": {
                    "200": {
                        "description": "Профиль текущего пользователя",
                        "schema": {
                            "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model_response.UserResponse"
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Не удалось получить пользователя",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Обновляет email и/или полное имя текущего пользователя.\nВсе поля необязательные. Если поле не передано, прежнее значение сохраняется.\nТребует валидную cookie `token`, полученную через /auth/login.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Обновить профиль текущего пользователя",
                "parameters": [
                    {
                        "description": "Данные обновления профиля: email и/или полное имя. Примеры значений указаны в схеме.",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model_request.UserUpdateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Обновлённый профиль пользователя",
                        "schema": {
                            "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model_response.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректное тело запроса",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Не удалось обновить пользователя",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/ping": {
            "get": {
                "description": "Лёгкая проверка маршрутизации API сервера.\nНе проверяет доступность PostgreSQL и сервиса прогнозирования.",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "Система"
                ],
                "summary": "Проверить доступность API сервера",
                "responses": {
                    "200": {
                        "description": "pong",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/products/export/assortment": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Скачивает отчёт по аналитике ассортимента в формате CSV или XML.\nКолонки CSV: `Товар`, `SKU`, `Категория`, `Выручка`, `Объём продаж`, `Группа ABC/XYZ`.\nПоля элемента XML: `name`, `sku`, `category`, `revenue`, `quantity`, `abc_xyz_group`.\nТребует валидную cookie `token`. Формат имени файла: `assortment_YYYY-MM-DD.csv` или `assortment_YYYY-MM-DD.xml`.",
                "produces": [
                    "text/csv",
                    "application/xml"
                ],
                "tags": [
                    "Экспорт"
                ],
                "summary": "Экспортировать аналитику ассортимента",
                "parameters": [
                    {
                        "enum": [
                            "csv",
                            "xml"
                        ],
                        "type": "string",
                        "default": "csv",
                        "description": "Формат экспорта. Пустое значение или `csv` возвращает CSV; `xml` возвращает XML.",
                        "name": "type",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Файл экспорта ассортимента",
                        "schema": {
                            "type": "file"
                        },
                        "headers": {
                            "Content-Disposition": {
                                "type": "string",
                                "description": "attachment; filename=\\\"assortment_2026-04-29.csv\\"
                            }
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Не удалось получить данные ассортимента",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/products/export/forecast": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Скачивает отчёт по рекомендациям прогноза в формате CSV или XML.\nКолонки CSV: `Товар`, `SKU`, `Прогноз продаж`, `Рекомендуемый запас`, `Текущий остаток`, `Статус`.\nПоля элемента XML: `name`, `sku`, `forecast_total`, `recommend_order`, `current_stock`, `urgency`.\nТребует валидную cookie `token`. Формат имени файла: `forecast_YYYY-MM-DD.csv` или `forecast_YYYY-MM-DD.xml`.",
                "produces": [
                    "text/csv",
                    "application/xml"
                ],
                "tags": [
                    "Экспорт"
                ],
                "summary": "Экспортировать рекомендации прогноза",
                "parameters": [
                    {
                        "maximum": 365,
                        "minimum": 1,
                        "type": "integer",
                        "default": 30,
                        "description": "Горизонт прогноза в днях. По умолчанию: 30.",
                        "name": "days",
                        "in": "query"
                    },
                    {
                        "maximum": 730,
                        "minimum": 1,
                        "type": "integer",
                        "default": 90,
                        "description": "Период истории продаж в днях. По умолчанию: 90.",
                        "name": "history",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "csv",
                            "xml"
                        ],
                        "type": "string",
                        "default": "csv",
                        "description": "Формат экспорта. Пустое значение или `csv` возвращает CSV; `xml` возвращает XML.",
                        "name": "type",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Файл экспорта прогноза",
                        "schema": {
                            "type": "file"
                        },
                        "headers": {
                            "Content-Disposition": {
                                "type": "string",
                                "description": "attachment; filename=\\\"forecast_2026-04-29.csv\\"
                            }
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Не удалось получить данные прогноза",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/products/forecast": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Строит прогноз спроса по каждому товару на указанный горизонт.\nСервер загружает историю продаж товаров из PostgreSQL и вызывает сервис прогнозирования.\nАдаптивный статистический прогноз продаж. Для товаров без продаж используется нулевой прогноз, для товаров с малым количеством данных — среднее значение за период, для редких продаж — метод Croston/SBA, для регулярных продаж — EWMA-прогноз с учетом недельной сезонности и тренда. История для модели: выбранный период.\nТребует валидную cookie `token`.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Прогноз"
                ],
                "summary": "Получить прогноз продаж по товарам",
                "parameters": [
                    {
                        "maximum": 365,
                        "minimum": 1,
                        "type": "integer",
                        "default": 30,
                        "description": "Горизонт прогноза в днях. По умолчанию: 30.",
                        "name": "days",
                        "in": "query"
                    },
                    {
                        "maximum": 730,
                        "minimum": 1,
                        "type": "integer",
                        "default": 90,
                        "description": "Период истории продаж в днях. По умолчанию: 90.",
                        "name": "history",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Прогноз по каждому товару с разбивкой по дням",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model.ForecastDetail"
                            }
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Не удалось получить прогноз",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/products/forecast/monthly": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Агрегирует прогнозное количество продаж и прогнозную выручку по месяцам.\nИспользуется для графиков и верхнеуровневого планирования выручки.\nТребует валидную cookie `token`.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Прогноз"
                ],
                "summary": "Получить помесячный прогноз",
                "parameters": [
                    {
                        "maximum": 365,
                        "minimum": 1,
                        "type": "integer",
                        "default": 30,
                        "description": "Горизонт прогноза в днях. По умолчанию: 30.",
                        "name": "days",
                        "in": "query"
                    },
                    {
                        "maximum": 730,
                        "minimum": 1,
                        "type": "integer",
                        "default": 90,
                        "description": "Период истории продаж в днях. По умолчанию: 90.",
                        "name": "history",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Итоги прогноза, сгруппированные по месяцам",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model.MonthlyPoint"
                            }
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Не удалось получить помесячный прогноз",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/products/recommendations": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Возвращает товары, у которых прогнозный спрос превышает текущий остаток.\n`recommend_order` равен прогнозному спросу минус текущий остаток.\n`urgency` зависит от запаса в днях: `high` \u003c= 7 дней, `medium` \u003c= 14 дней, иначе `ok`.\nТребует валидную cookie `token`.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Прогноз"
                ],
                "summary": "Получить рекомендации по закупкам",
                "parameters": [
                    {
                        "maximum": 365,
                        "minimum": 1,
                        "type": "integer",
                        "default": 30,
                        "description": "Горизонт прогноза в днях. По умолчанию: 30.",
                        "name": "days",
                        "in": "query"
                    },
                    {
                        "maximum": 730,
                        "minimum": 1,
                        "type": "integer",
                        "default": 90,
                        "description": "Период истории продаж в днях. По умолчанию: 90.",
                        "name": "history",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список рекомендаций по закупкам, отсортированный по срочности",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model.RecommendationItem"
                            }
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Не удалось получить рекомендации",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/products/sell-detail": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Возвращает продажи товаров, сгруппированные по дате продажи, товару и категории.\nФильтр периода передаётся query-параметрами `from` и `to` в формате `YYYY-MM-DD`.\nЕсли `from` не передан, используется дата месяц назад. Если `to` не передан, используется текущая дата.\nТребует валидную cookie `token`.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Товары"
                ],
                "summary": "Получить детализацию продаж",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Начало периода включительно в формате YYYY-MM-DD. Пример: 2026-02-01.",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Конец периода включительно в формате YYYY-MM-DD. Пример: 2026-04-30.",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Строки детализации продаж",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model.SaleDetail"
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректные query-параметры",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Не удалось получить детализацию продаж",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_AVGsync_analysis-pro_backend_internal_model.DailyPoint": {
            "type": "object",
            "properties": {
                "date": {
                    "type": "string"
                },
                "quantity": {
                    "type": "integer"
                }
            }
        },
        "github_com_AVGsync_analysis-pro_backend_internal_model.ForecastDetail": {
            "type": "object",
            "properties": {
                "daily_avg": {
                    "type": "number"
                },
                "daily_breakdown": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_AVGsync_analysis-pro_backend_internal_model.DailyPoint"
                    }
                },
                "forecast_total": {
                    "type": "integer"
                },
                "method": {
                    "type": "string"
                },
                "product_id": {
                    "type": "integer"
                },
                "product_name": {
                    "type": "string"
                },
                "sku": {
                    "type": "string"
                }
            }
        },
        "github_com_AVGsync_analysis-pro_backend_internal_model.MonthlyPoint": {
            "type": "object",
            "properties": {
                "forecast_qty": {
                    "type": "integer"
                },
                "forecast_revenue": {
                    "type": "number"
                },
                "month": {
                    "type": "string"
                }
            }
        },
        "github_com_AVGsync_analysis-pro_backend_internal_model.RecommendationItem": {
            "type": "object",
            "properties": {
                "current_stock": {
                    "type": "integer"
                },
                "forecast_total": {
                    "type": "integer"
                },
                "product_id": {
                    "type": "integer"
                },
                "product_name": {
                    "type": "string"
                },
                "recommend_order": {
                    "type": "integer"
                },
                "sku": {
                    "type": "string"
                },
                "stock_days_left": {
                    "type": "integer"
                },
                "urgency": {
                    "type": "string"
                }
            }
        },
        "github_com_AVGsync_analysis-pro_backend_internal_model.SaleDetail": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string",
                    "example": "Смартфоны"
                },
                "product_name": {
                    "type": "string",
                    "example": "iPhone 15"
                },
                "quantity": {
                    "type": "integer",
                    "example": 4
                },
                "revenue": {
                    "type": "number",
                    "example": 399996
                },
                "sold_at": {
                    "type": "string",
                    "example": "2026-04-29T00:00:00Z"
                }
            }
        },
        "github_com_AVGsync_analysis-pro_backend_internal_model_request.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "description": "Email зарегистрированного пользователя.",
                    "type": "string",
                    "example": "ivan.petrov@example.com"
                },
                "password": {
                    "description": "Пароль пользователя.",
                    "type": "string",
                    "example": "Str0ngPass!2026"
                }
            }
        },
        "github_com_AVGsync_analysis-pro_backend_internal_model_request.NewUserRequest": {
            "type": "object",
            "required": [
                "email",
                "full_name",
                "password"
            ],
